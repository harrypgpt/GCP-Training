# ---------------------------------------------------------------------------
# Root-level shared defaults. Copy to `.env` for local development.
# Each app also has its own `.env.example` (apps/api, apps/web).
# NEVER commit a real `.env` file. Secrets belong in your shell / secret store.
# ---------------------------------------------------------------------------

# PostgreSQL (consumed by infra/docker-compose.yml)
POSTGRES_USER=gcp
POSTGRES_PASSWORD=gcp_local_dev_only
POSTGRES_DB=gcp_training
POSTGRES_PORT=5432

# Adminer (DB inspection UI)
ADMINER_PORT=8080

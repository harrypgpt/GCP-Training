# Use a flat, hoisted node_modules layout.
#
# Prisma generates its client into the physical location of `@prisma/client`.
# With pnpm's default isolated linker this interacts badly in a workspace
# (the generated client and the stub can resolve inconsistently). The hoisted
# linker is Prisma's documented recommendation for pnpm and keeps client
# resolution deterministic across `dev`, `build`, `test` and CI.
node-linker=hoisted

# Keep lockfile-driven installs strict.
strict-peer-dependencies=false
auto-install-peers=true

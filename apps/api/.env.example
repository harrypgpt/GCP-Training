# ---------------------------------------------------------------------------
# API service configuration. Copy to `apps/api/.env` for local development.
# The API validates these on boot (see src/config/env.schema.ts) and refuses
# to start if anything is missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development

# HTTP
PORT=3001

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Base URL of the learner-facing web app - used only to build the public
# certificate verification URL (Gate 8). Never localhost in production.
PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Matches the defaults in infra/docker-compose.yml (or a native install —
# see README "Getting started").
DATABASE_URL=postgresql://gcp:gcp_local_dev_only@localhost:5432/gcp_training?schema=public

# Global rate limit (requests per window per IP).
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

# ---------------------------------------------------------------------------
# Authentication (Stage 3)
# ---------------------------------------------------------------------------

# Signing secret for access + email-verification JWTs. Generate a real one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER reuse this example value outside local development.
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-please
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=10

# Server-side pepper mixed into every OTP hash. Generate the same way as
# JWT_ACCESS_SECRET above. NEVER reuse this example value outside local dev.
OTP_PEPPER=dev-only-otp-pepper-change-me
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Mail delivery
# `console` (default) logs the email — including the OTP — to the server
# console instead of sending it. Safe for local development; never enable in
# production. Set MAIL_TRANSPORT=smtp + the SMTP_* vars for real delivery
# (works with a local catcher like Mailpit, or any real SMTP relay).
# ---------------------------------------------------------------------------

MAIL_TRANSPORT=console
MAIL_FROM=no-reply@gcp-training.local
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# AI content intelligence foundation (Stage 6B)
# AI only ever produces CANDIDATE content for human review — it can never
# publish a question. `mock` is deterministic and requires no external API;
# it is the only provider guaranteed to work offline/in CI.
# ---------------------------------------------------------------------------

AI_ENABLED=true
AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Blanket safety switch: even with a real provider configured, external
# calls are refused unless this is explicitly true. Per-content eligibility
# (ExternalAiEligibility on case studies/observations) is checked in
# addition to, not instead of, this flag.
AI_EXTERNAL_CONTENT_ALLOWED=false
# Required only when AI_PROVIDER=openai. Never sent to the frontend.
# OPENAI_API_KEY=
# Required only when AI_PROVIDER=gemini. Never sent to the frontend. Get a
# key from https://aistudio.google.com/apikey. When using Gemini, set
# AI_MODEL to a real, currently-serving Gemini model name (verify via the
# real API's own /v1beta/models endpoint - model availability changes over
# time and old names 404 without notice), e.g. AI_MODEL=gemini-3.5-flash-lite.
# GEMINI_API_KEY=
